{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/importMeta"],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
