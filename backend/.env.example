# Database
DATABASE_URL=sqlite+aiosqlite:///./data/videos.db

# Video Storage
VIDEO_STORAGE_PATH=./data/videos
THUMBNAIL_PATH=./data/thumbnails

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scan Settings
DEFAULT_SCAN_INTERVAL=3600

# Auth Settings
SESSION_HOURS=12
REMEMBER_ME_DAYS=30
# 仅在通过 https 访问时打开；局域网 http 下保持 false，否则 Cookie 不会被发送
AUTH_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=10

# Object storage（只有添加 S3/MinIO 类型视频源时才需要，另需 uv sync --extra s3）
# 留空 endpoint 即连 AWS；自建 MinIO/RustFS 填 http://192.168.1.10:9000
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 域名寻址（bucket.host/key）连不上时改 path（host/bucket/key）
S3_ADDRESSING_STYLE=auto
