# Database（默认方言是 PostgreSQL；库和角色的建法见 deploy/pg-provision.example.sql，
# 把 <口令> 换成那份里给 home_sites_app 设的真口令，别提交换好之后的这份）
DATABASE_URL=postgresql+asyncpg://home_sites_app:<口令>@127.0.0.1:5432/home_sites
# 回滚或临时试跑才换成这一行（README「回滚」一节）：
# DATABASE_URL=sqlite+aiosqlite:///./data/videos.db

# Video Storage
VIDEO_STORAGE_PATH=./data/videos
THUMBNAIL_PATH=./data/thumbnails

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scan Settings
DEFAULT_SCAN_INTERVAL=3600

# Database backups（只在 DATABASE_URL 是 PostgreSQL 时才挂载，SQLite 不备份）
# 目录相对 backend/ 展开；留空 BACKUP_DIR 或 BACKUP_ENABLED=false 都能关掉
BACKUP_ENABLED=true
BACKUP_DIR=./data/pg-backups
# 旧备份保留天数；0 表示不轮转（只增不删）
BACKUP_KEEP_DAYS=7
# 每天几点跑（服务器本地时区，24 小时制）
BACKUP_TIME=03:30
# Windows 上 PostgreSQL 的 bin 目录默认不在 PATH 里，指过去；留空按 PATH 找
# PG_BINDIR=D:\Program Files\PostgreSQL\18\bin

# Auth Settings
SESSION_HOURS=12
REMEMBER_ME_DAYS=30
# 仅在通过 https 访问时打开；局域网 http 下保持 false，否则 Cookie 不会被发送
AUTH_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=10

# Object storage（只有添加 S3/MinIO 类型视频源时才需要，另需 uv sync --extra s3）
# 留空 endpoint 即连 AWS；自建 MinIO/RustFS 填 http://192.168.1.10:9000
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 域名寻址（bucket.host/key）连不上时改 path（host/bucket/key）
S3_ADDRESSING_STYLE=auto
